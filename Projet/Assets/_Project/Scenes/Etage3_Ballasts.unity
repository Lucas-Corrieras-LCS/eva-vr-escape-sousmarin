  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Abysses.Level.CrewLog
  playButton: {fileID: 2105330880}
  screen: {fileID: 134928748}
  radio: {fileID: 670038834}
  french: "Ing. Ines Vald\xE8s \u2014 Jour 213, nuit.\nPour descendre au c\u0153ur,
    il faut chasser les ballasts : les quatre leviers d'un coup. Avant \xE7a, videz
    l'eau et lancez la purge. Et parlez-vous. Cette station ne pardonne pas le silence."
  english: "Eng. Ines Vald\xE8s \u2014 Day 213, night.\nTo reach the core, the ballasts
    must be blown: all four levers at once. Before that, pump out the water and run
    the purge. And talk to each other. This station does not forgive silence."
  charactersPerSecond: 28
