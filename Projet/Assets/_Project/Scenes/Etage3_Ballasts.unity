  m_Script: {fileID: 11500000, guid: e5d9f1182fc3e41e8a2ae214deeea00d, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Abysses.Level.PuzzleObjective
  ShowTopMostFoldoutHeaderGroup: 1
  floor: 3
  quadrant: 1
  label: "Cale \xE9lectrifi\xE9e CYAN"
  labelEnglish: Electrified hold CYAN
  hints:
  - "Une partie de la cale est \xE9lectrifi\xE9e : seules certaines dalles sont s\xFBres,
    et rien ne les distingue."
  - "Un autre plongeur voit la carte de TA cale et ta position en direct sur son
    \xE9cran de surveillance : laisse-le te guider."
  - "Pars de la dalle D\xC9PART. Une d\xE9charge te renvoie au d\xE9part ; sortir
    de la grille aussi. Avance case par case jusqu'\xE0 la vanne."
  hintsEnglish:
  - 'Part of the hold is electrified: only some tiles are safe, and nothing tells
    them apart.'
  - 'Another diver sees YOUR hold''s map and your live position on their monitor:
    let them guide you.'
  - Start from the START tile. A shock sends you back; so does leaving the grid.
    Move tile by tile to the valve.
