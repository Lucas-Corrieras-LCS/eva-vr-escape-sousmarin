  m_Script: {fileID: 11500000, guid: 830476eb9bc514ad8a1d432ecb40f0e1, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Abysses.Level.CrewLog
  playButton: {fileID: 1091900871}
  screen: {fileID: 1471261170}
  radio: {fileID: 1967508573}
  french: "Cmdt R\xE9a Morel \u2014 Jour 213, soir.\nLa coque fuit aux ballasts.
    Les pompes de cale tiennent, \xE0 condition d'ouvrir les bonnes vannes. Les sch\xE9mas
    ont \xE9t\xE9 affich\xE9s dans le module voisin, comme tout le reste ici. Ne
    forcez pas : un coup de b\xE9lier et l'eau monte d'un coup."
  english: "Cdr R\xE9a Morel \u2014 Day 213, evening.\nThe hull is leaking at the
    ballasts. The bilge pumps hold, as long as the right valves are open. The diagrams
    were posted in the next module, like everything else here. Don't force it: one
    water hammer and the water surges up."
  charactersPerSecond: 28
