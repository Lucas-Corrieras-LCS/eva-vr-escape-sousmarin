  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Abysses.Level.PuzzleObjective
  ShowTopMostFoldoutHeaderGroup: 1
  floor: 2
  quadrant: 2
  label: "Manom\xE8tre VERT"
  labelEnglish: Gauge GREEN
  hints:
  - "Ta vanne ne r\xE8gle pas ton manom\xE8tre : elle r\xE8gle celui d'un autre plongeur."
  - "Parlez \xE0 voix haute : chacun annonce o\xF9 est son aiguille par rapport \xE0
    la zone verte."
  - "Tournez les vannes doucement, une \xE0 la fois : l'aiguille doit rester quelques
    secondes dans le vert."
  hintsEnglish:
  - 'Your valve does not drive your gauge: it drives another diver''s.'
  - 'Talk out loud: each of you says where your needle is compared to the green zone.'
  - 'Turn the valves slowly, one at a time: the needle must stay in the green for
    a few seconds.'
