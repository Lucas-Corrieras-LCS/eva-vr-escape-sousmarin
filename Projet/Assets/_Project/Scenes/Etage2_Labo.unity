  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Abysses.Level.CrewLog
  playButton: {fileID: 1005070141}
  screen: {fileID: 1970333672}
  radio: {fileID: 1767611545}
  french: "Ing. Ines Vald\xE8s \u2014 Jour 213.\nJ'ai not\xE9 les codes \xE0 l'encre
    UV : les cr\xE9atures du dehors r\xE9agissent \xE0 la lumi\xE8re vive. Une seule
    lampe UV fonctionne encore. Elle voyage par les sas."
  english: "Eng. Ines Vald\xE8s \u2014 Day 213.\nI wrote the codes in UV ink: the
    creatures outside react to bright light. Only one UV lamp still works. It travels
    through the airlocks."
  charactersPerSecond: 28
