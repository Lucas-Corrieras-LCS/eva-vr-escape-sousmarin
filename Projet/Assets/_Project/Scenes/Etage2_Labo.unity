  m_Script: {fileID: 11500000, guid: 830476eb9bc514ad8a1d432ecb40f0e1, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Abysses.Level.CrewLog
  playButton: {fileID: 1137428805}
  screen: {fileID: 1141543554}
  radio: {fileID: 221171968}
  french: "Cmdt R\xE9a Morel \u2014 Jour 213.\nLa pression grimpe au laboratoire.
    Les vannes ont \xE9t\xE9 crois\xE9es pendant la construction : chacun r\xE8gle
    la pression d'un autre. On a pass\xE9 la nuit \xE0 se crier des chiffres \xE0
    travers les cloisons."
  english: "Cdr R\xE9a Morel \u2014 Day 213.\nPressure is rising in the lab. The
    valves were cross-wired during construction: each one sets someone else's pressure.
    We spent the night shouting numbers through the walls."
  charactersPerSecond: 28
