  m_Script: {fileID: 11500000, guid: 830476eb9bc514ad8a1d432ecb40f0e1, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Abysses.Level.CrewLog
  playButton: {fileID: 1735353723}
  screen: {fileID: 274340987}
  radio: {fileID: 1864214006}
  french: "Cmdt R\xE9a Morel \u2014 Jour 212.\nCoupure g\xE9n\xE9rale \xE0 03 h 10.
    Le r\xE9seau a disjonct\xE9 module par module. J'ai retir\xE9 les fusibles pour
    \xE9viter l'incendie et je les ai confi\xE9s aux modules voisins. Si vous lisez
    ceci : remettez le courant ensemble."
  english: "Cdr R\xE9a Morel \u2014 Day 212.\nTotal blackout at 03:10. The grid tripped
    module by module. I pulled the fuses to prevent a fire and left them with the
    neighbouring modules. If you read this: restore the power together."
  charactersPerSecond: 28
