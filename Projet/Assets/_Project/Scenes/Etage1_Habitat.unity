  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e5d9f1182fc3e41e8a2ae214deeea00d, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Abysses.Level.PuzzleObjective
  ShowTopMostFoldoutHeaderGroup: 1
  floor: 1
  quadrant: 3
  label: Digicode MAGENTA
  labelEnglish: Keypad MAGENTA
  hints:
  - "Le code de ton digicode n'est pas chez toi : il est affich\xE9 dans le module
    voisin."
  - "Ton co\xE9quipier a ton code sur son mur du fond, et lui seul peut le lire :
    demande-lui de te le dicter."
  - "Chaque symbole a une forme ET une couleur : dictez-les de gauche \xE0 droite
    (\xAB cercle rouge, \xE9toile jaune\u2026 \xBB)."
  hintsEnglish:
  - 'Your keypad code is not in your module: it is displayed in the neighbouring
    one.'
  - 'Your teammate has your code on their back wall, and only they can read it: ask
    them to read it out.'
  - "Each symbol has a shape AND a colour: read them left to right (\u201Cred circle,
    yellow star\u2026\u201D)."
