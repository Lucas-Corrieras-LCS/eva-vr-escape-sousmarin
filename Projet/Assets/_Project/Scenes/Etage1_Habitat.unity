  m_Script: {fileID: 11500000, guid: e5d9f1182fc3e41e8a2ae214deeea00d, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Abysses.Level.PuzzleObjective
  ShowTopMostFoldoutHeaderGroup: 1
  floor: 1
  quadrant: -1
  label: Remise sous tension
  labelEnglish: Power restore
  hints:
  - "Les leviers ne r\xE9pondent qu'une fois toutes les autres \xE9nigmes de l'\xE9tage
    r\xE9solues."
  - "Tous les leviers doivent \xEAtre abaiss\xE9s presque en m\xEAme temps."
  - "Comptez ensemble \xAB 3, 2, 1, maintenant ! \xBB et tirez tous votre levier
    au m\xEAme moment."
  hintsEnglish:
  - The levers only respond once every other puzzle on this floor is solved.
  - All the levers must be pulled down at almost the same time.
  - "Count together \u201C3, 2, 1, now!\u201D and all pull your lever at the same
    moment."
