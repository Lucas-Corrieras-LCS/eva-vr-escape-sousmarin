  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Abysses.Level.CrewLog
  playButton: {fileID: 2018471760}
  screen: {fileID: 538661044}
  radio: {fileID: 987955831}
  french: "Cmdt R\xE9a Morel \u2014 Jour 214.\nQuelque chose de tr\xE8s grand tourne
    autour de la station. Le r\xE9acteur est en s\xE9curit\xE9. Pour le relancer,
    il faut toute l'\xE9quipe, chacun \xE0 sa console. Puis la remont\xE9e d'urgence."
  english: "Cdr R\xE9a Morel \u2014 Day 214.\nSomething very large is circling the
    station. The reactor is in safe mode. Restarting it takes the whole team, each
    at their console. Then the emergency ascent."
  charactersPerSecond: 28
