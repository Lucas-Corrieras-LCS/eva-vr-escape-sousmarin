  m_EditorClassIdentifier: Assembly-CSharp::Abysses.Level.CrewLog
  playButton: {fileID: 1252138180}
  screen: {fileID: 525620507}
  radio: {fileID: 1524035357}
  french: "Ing. Ines Vald\xE8s \u2014 Jour 214, dernier message.\nNous partons par
    la capsule de secours. Laissez les leviers de remont\xE9e pour la fin, et tirez-les
    ensemble. Bonne chance, plongeurs."
  english: "Eng. Ines Vald\xE8s \u2014 Day 214, last entry.\nWe are leaving in the
    escape pod. Keep the ascent levers for last, and pull them together. Good luck,
    divers."
  charactersPerSecond: 28
